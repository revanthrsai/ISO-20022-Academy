# Copy to .env for local runs. On Render, set these under Environment.
GOOGLE_API_KEY=your-gemini-api-key-from-google-ai-studio
GEMINI_MODEL=gemini-3.5-flash
ALLOWED_ORIGINS=https://iso20022academy.in,https://www.iso20022academy.in,http://localhost:5500,http://127.0.0.1:5500
RATE_PER_MINUTE=6
RATE_PER_DAY=40
DAILY_REQUEST_CAP=500
# Speed: LOW thinking and at most 2 attempts (the 2nd only when our checks find problems).
THINKING_LEVEL=MINIMAL
MAX_OUTPUT_TOKENS=4096
MAX_ATTEMPTS=2
ATTEMPT_TIMEOUT_S=45

# Owner-only dashboard (/insights/). Set these on Render only.
ADMIN_KEY=            # 16+ characters; the key you type on /insights/
CF_API_TOKEN=         # Cloudflare API token with "Account Analytics: Read"
CF_ACCOUNT_ID=        # Cloudflare account ID (dashboard URL / account home)
CF_SITE_TAG=          # optional: the Web Analytics site tag; otherwise SITE_HOST is used
SITE_HOST=iso20022academy.in
