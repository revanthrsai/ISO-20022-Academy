.DS_Store
Thumbs.db
*.log
.vscode/

# Local dev only. The deployed site is zero-dependency — nothing here is
# needed to run it. jsdom is installed by hand to run scripts/test-*.js
# (`npm i jsdom`), and the Pages workflow uploads the whole directory as the
# artifact, so an accidentally committed node_modules would be published to
# the live site.
/node_modules/
/package.json
/package-lock.json

assets/video/
docs/curriculum-roadmap.md
docs/ENGINE-SPEC.md
/assets/cheatsheets

# Build artifacts — regenerated on every deploy by scripts/build-seo.js.
# Source of truth is /content and the data files; never edit these by hand.
/library/
/dictionary/
/glossary/
/workshop/
/playground/
/history/
/whats-new/
/journey/
/reference/
/404.html
/sitemap.xml
/robots.txt

# Playground sample manifest — regenerated from /samples/*.json by build-samples.js.
# The /samples/*.json files themselves ARE source and stay tracked.
/samples/manifest.json

# Transform API (Java/Spring Boot) lives in this repo, but it does NOT run on
# GitHub Pages — deploy it separately to a Java host (Cloud Run / Render) from
# the /transform-api subfolder. Its own build output is ignored via
# transform-api/.gitignore. The source is tracked here.

# Internal planning docs — kept local, not published to the public site.
/BACKLOG.md
/LAUNCH-KIT-v2.md
/LAUNCH-KIT.md
/video-scripts/
